{
  "expo": {
    "name": "Triglav Trainer",
    "slug": "triglav-trainer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.barbarapolicar.triglavtrainer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.barbarapolicar.triglavtrainer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Triglav Trainer uses your location to track runs and hikes (distance, elevation, pace)."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Triglav Trainer adds your workouts and German study blocks to your calendar and plans around your existing events."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Triglav Trainer uses the altimeter to measure how many metres you climb."
        }
      ]
    ]
  }
}
